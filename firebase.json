{
  "hosting": {
    "target": "rgv-multi-tech-services",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/vendor/**",
      "**/*.php",
      "storage/**",
      "hot"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "rgv-system",
          "region": "asia-southeast1"
        }
      }
    ]
  }
}