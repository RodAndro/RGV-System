APP_NAME=RGV-Multi-Tech-Services
APP_ENV=local
APP_KEY=
APP_DEBUG=true
DEBUGBAR_ENABLED=false
APP_URL=http://localhost
APP_DOMAIN=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_PAGE_VISITS=false

DB_CONNECTION=mysql
# Local MySQL/MariaDB defaults. For a managed server, replace these values;
# never commit real credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rgv_system
DB_USERNAME=rgv
DB_PASSWORD=
# Optional path to the MySQL client bin folder containing mysqldump and mysql.
DB_DUMP_BINARY_PATH=

# Optional local/test demo users. No default passwords are provided.
DEMO_ADMIN_EMAIL=demo-admin@example.test
DEMO_ADMIN_PASSWORD=
DEMO_EMPLOYEE_EMAIL=demo-employee@example.test
DEMO_EMPLOYEE_PASSWORD=

# Use local files for single-instance development to avoid a database round trip per request.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# For multi-instance deployments, use a shared cache/session store such as Redis.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_QUEUE_CONNECTION=queue

# MySQL read/write splitting.
DB_READ_HOSTS=127.0.0.1
DB_WRITE_HOST=127.0.0.1
DB_STICKY=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TEMPERATURE=0.3
OLLAMA_TIMEOUT=120

APP_VERSION=1.0.0
APP_COMMIT=

# Mobile API token authentication (Laravel Sanctum)
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=

# Origin(s) allowed by CORS for the SPA client (Q4). Comma separated.
FRONTEND_URL=http://localhost:5173

# Authentication policy (read by AppServiceProvider, LoginRequest and the
# mobile AuthController).
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5

# Tiered API rate limits (requests per minute) enforced by
# TieredRateLimitMiddleware.
API_PUBLIC_RATE_LIMIT=30
API_STANDARD_RATE_LIMIT=60
API_PREMIUM_RATE_LIMIT=120
API_ADMIN_RATE_LIMIT=300

# Notification and backup mail routing.
NOTIFICATION_EMAIL_ENABLED=true
BACKUP_NOTIFICATION_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
SYSTEM_NOTIFICATION_EMAIL=
BACKUP_TO_S3=false

# Branding/settings defaults editable from the admin settings screen.
APP_TAGLINE=RGV Multi-Tech Services
APP_ACCENT_COLOR=#0f6f9d

# Maintenance mode messaging.
MAINTENANCE_MESSAGE=
MAINTENANCE_ALLOWED_IPS=

# Previous APP_KEY values kept during key rotation.
APP_PREVIOUS_KEYS=

# Optional Slack channel for error-level logs.
LOG_SLACK_WEBHOOK_URL=

# Mail transport used when sending real notifications (log, smtp, sendmail).
MAIL_ENCRYPTION=

# Who receives generated report notifications.
REPORT_NOTIFICATION_EMAIL=

# Set automatically by the deployment pipeline so /api/health can report the
# deployed commit. Leave empty when running locally.
GITHUB_SHA=
