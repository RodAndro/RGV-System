# Dedicated service database principal. Never use the Flutter app for DB access.
DB_HOST=YOUR_POSTGRES_HOST
DB_PORT=5432
DB_NAME=postgres
# For the Supabase Session pooler, append the project ref (rgv_mobile_api.<ref>).
DB_USER=rgv_mobile_api
DB_PASSWORD=GENERATE_AND_STORE_OUTSIDE_REPOSITORY
DB_SSLMODE=verify-full
DB_SSLROOTCERT=

# Exact server-side APP_KEY value used by Laravel to keep audit checksums in
# the same chain. Store this in the service's secret manager.
AUDIT_HMAC_KEY=base64:SET_TO_THE_EXISTING_LARAVEL_APP_KEY
APP_TIMEZONE=UTC
APP_URL=https://YOUR_WEB_HOST

# Optional SMTP for the same new-request email side effect. In-app alerts are
# written to PostgreSQL even when SMTP is not configured.
NOTIFICATION_EMAIL_ENABLED=true
ADMIN_NOTIFICATION_EMAIL=
BACKUP_NOTIFICATION_EMAIL=
SYSTEM_NOTIFICATION_EMAIL=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MOBILE_API_PORT=8081
