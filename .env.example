APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
DEBUGBAR_ENABLED=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_PAGE_VISITS=false

# PostgreSQL (Supabase session pooler — IPv4, port 5432; use this if the direct host is unreachable)
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<your-supabase-project-ref>
DB_PASSWORD=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=3
DB_RETRY_ATTEMPTS=1

# Server-only key for provisioning employee accounts through Supabase Auth.
# Never use this key in the Flutter application.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# PostgreSQL (Supabase direct connection — resolves to IPv6; enable IPv4 or use the pooler above)
# DB_HOST=db.<your-supabase-project-ref>.supabase.co
# DB_USERNAME=postgres

# Use local files for single-instance development to avoid a database round trip per request.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# For multi-instance deployments, use a shared cache/session store such as Redis.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_QUEUE_CONNECTION=queue

# MySQL read/write splitting.
DB_READ_HOSTS=127.0.0.1
DB_WRITE_HOST=127.0.0.1
DB_STICKY=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TEMPERATURE=0.3
OLLAMA_TIMEOUT=120

# Mobile API token authentication (Laravel Sanctum)
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=

