APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
DEBUGBAR_ENABLED=false
APP_URL=http://localhost
APP_DOMAIN=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_PAGE_VISITS=false

DB_CONNECTION=pgsql
# Supabase Session pooler host and username from Dashboard > Connect.
SUPABASE_PROJECT_URL=https://fywtxrptaqcmkzsgfehp.supabase.co
SUPABASE_URL=https://fywtxrptaqcmkzsgfehp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_l0nUDT07PxzQ-nOnEK4E5w_fCfIlgM2
# Server-only secret key for Supabase Auth Admin API. Never expose to Flutter.
SUPABASE_SECRET_KEY=
# Optional legacy service_role JWT fallback for older Supabase projects.
SUPABASE_SERVICE_ROLE_KEY=
DB_HOST=aws-1-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.fywtxrptaqcmkzsgfehp
DB_PASSWORD=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=3
DB_RETRY_ATTEMPTS=1
# Optional path to the Supabase root certificate; pair with DB_SSLMODE=verify-full.
DB_SSLROOTCERT=
# For direct connections, use db.<project-ref>.supabase.co on IPv6-capable hosts.
# Optional PostgreSQL client bin directory containing pg_dump and psql.
DB_DUMP_BINARY_PATH=

# Optional local/test demo users. No default passwords are provided.
DEMO_ADMIN_EMAIL=demo-admin@example.test
DEMO_ADMIN_PASSWORD=
DEMO_EMPLOYEE_EMAIL=demo-employee@example.test
DEMO_EMPLOYEE_PASSWORD=

# Use local files for single-instance development to avoid a database round trip per request.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# For multi-instance deployments, use a shared cache/session store such as Redis.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_QUEUE_CONNECTION=queue

# MySQL read/write splitting.
DB_READ_HOSTS=127.0.0.1
DB_WRITE_HOST=127.0.0.1
DB_STICKY=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TEMPERATURE=0.3
OLLAMA_TIMEOUT=120

APP_VERSION=1.0.0
APP_COMMIT=

# Mobile API token authentication (Laravel Sanctum)
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=

