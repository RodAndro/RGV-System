# ---------------------------------------------------------------------
# Docker Compose variables (root .env).
#
# Docker Compose reads THIS file for ${...} interpolation. It does not
# read Backend/.env for interpolation, which is why every variable used
# in compose.yaml must be listed here.
#
# Copy to .env before running `docker compose up -d`.
# ---------------------------------------------------------------------

# Public hostname served by Caddy. Use a real domain for automatic HTTPS.
APP_DOMAIN=localhost

# Deployed commit. CI sets this to ${{ github.sha }}.
APP_COMMIT=

# MySQL container settings.
DB_DATABASE=rgv
DB_USERNAME=rgv
DB_PASSWORD=change-me-in-real-deployments
DB_ROOT_PASSWORD=change-me-too
DB_PORT=3306

# Leave DB_HOST empty to use the bundled `db` container.
# Set DB_HOST to an external host (for example a managed MySQL instance)
# to use that instead.
DB_HOST=

# Origin allowed by CORS for the SPA.
FRONTEND_URL=http://localhost

# Ollama is provided by the `ollama` service.
OLLAMA_BASE_URL=http://ollama:11434

# Cloudflare Tunnel token. Only needed with --profile tunnel.
TUNNEL_TOKEN=
