APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
DEBUGBAR_ENABLED=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (Supabase session pooler — IPv4, port 5432; use this if the direct host is unreachable)
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<your-supabase-project-ref>
DB_PASSWORD=
DB_SSLMODE=require

# PostgreSQL (Supabase direct connection — resolves to IPv6; enable IPv4 or use the pooler above)
# DB_HOST=db.<your-supabase-project-ref>.supabase.co
# DB_USERNAME=postgres

# Local development (SQLite)
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=
BOOK_TARGET_ISBN_MS=50
BOOK_TARGET_CATALOG_MS=100
BOOK_TARGET_CATEGORY_MS=150
BOOK_TARGET_SEARCH_MS=300
BOOK_TARGET_CACHE_MS=10
MASS_BOOK_SEED=false
MASS_BOOK_SEED_COUNT=1000000
MASS_BOOK_SEED_CHUNK=5000
SCOUT_DRIVER=database
SCOUT_QUEUE=true
BOOK_SHARDING_ENABLED=false
BOOK_SHARDING_STRATEGY=id_range

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_QUEUE_CONNECTION=queue

# MySQL read/write splitting.
DB_READ_HOSTS=127.0.0.1
DB_WRITE_HOST=127.0.0.1
DB_STICKY=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TEMPERATURE=0.3
OLLAMA_TIMEOUT=120

# Mobile API token authentication (Laravel Sanctum)
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=

# Google Drive return-proof uploads (service account)
# Recommended: absolute path to the service-account JSON key file on the server.
GOOGLE_DRIVE_CREDENTIALS_PATH=
# Alternative: the service-account JSON inlined as a single-line string.
GOOGLE_DRIVE_CREDENTIALS_JSON=
# The shared evidence folder ID (do not commit credentials).
GOOGLE_DRIVE_FOLDER_ID=
# Optional: the employee-facing account subject for domain-wide delegation.
GOOGLE_DRIVE_SUBJECT=
